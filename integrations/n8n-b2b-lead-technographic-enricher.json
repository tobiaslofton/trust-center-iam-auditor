{
  "name": "B2B Domain Technographic, SOC 2 & AI Sub-processor Enricher (Apify)",
  "nodes": [
    {
      "parameters": {
        "content": "## 🚀 B2B Technographic & AI Stack Enricher\nEnriches company domains with live **Trust Center platforms** (Vanta, Drata, SafeBase), **SOC 2 / ISO 27001 certifications**, **disclosed AI/Cloud sub-processors** (OpenAI, Anthropic, AWS, Snowflake), and **DNS Identity Providers** (Okta, Entra ID, Google Workspace, Wiz).\n\n### Setup (30 Seconds):\n1. Get a free API token at [console.apify.com/settings/integrations](https://console.apify.com/settings/integrations)\n2. Open the **Run Trust Center & IAM Auditor (Apify)** node and replace `YOUR_APIFY_API_TOKEN` in the Query Parameters.\n3. Click **Test workflow**!",
        "height": 260,
        "width": 520
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [220, 80]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "domains-list",
              "name": "domains",
              "value": "={{ [\"vanta.com\", \"drata.com\", \"linear.app\"] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Set Target Prospect Domains",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/AlgernonTechnologies~trust-center-iam-auditor/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "YOUR_APIFY_API_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"domains\": {{ JSON.stringify($json.domains) }},\n  \"check_status_page\": true,\n  \"max_concurrency\": 5\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Run Trust Center & IAM Auditor (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-trust-score",
              "leftValue": "={{ $json.trust_score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Filter Enterprise-Ready Prospects",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 400]
    }
